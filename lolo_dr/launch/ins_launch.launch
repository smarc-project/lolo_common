<launch>
  <!--Launch file for testing the INS -> ODOM, map_odom_initializer_node is used to define odom's fixed transform -->
  <arg name="robot_name" default="lolo" />

  <node pkg="lolo_dr" exec="map_odom_initializer_node" output="screen" namespace="$(var robot_name)">
    <param name="update_rate" value="1.0" />
    <param name="verbose" value="true" />
  </node>

  <node pkg="lolo_dr" exec="ins_2_odom_node" name="ins_2_odom_node" output="screen" namespace="$(var robot_name)">
    <param name="automatic_zone" value="true" />
    <param name="verbose_setup" value="true" />
    <param name="verbose_conversion" value="true" />
  </node>


  <node pkg="lolo_dr" exec="ins_2_control_node" name="ins_2_control_node" output="screen" namespace="$(var robot_name)">
    <param name="output_rate" value="10.0" />
  </node>

</launch>
